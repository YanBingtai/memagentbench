+                extra_body["thinking"] = thinking
+            else:
+                raise TypeError("thinking must be a bool, str, dict, or None")
+
+        return extra_body or None
+
+    def _mimo_thinking_enabled(self) -> bool:
+        if not isinstance(self.config.model, str) or not self.config.model.startswith("mimo-"):
+            return False
+
+        thinking = getattr(self.config, "thinking", None)
+        if thinking is None:
+            thinking = (getattr(self.config, "extra_body", {}) or {}).get("thinking")
+        if isinstance(thinking, bool):
+            return thinking
+        if isinstance(thinking, str):
+            return thinking == "enabled"
+        if isinstance(thinking, dict):
+            return thinking.get("type") == "enabled"
+        return True
+
